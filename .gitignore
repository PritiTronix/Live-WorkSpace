# Python Virtual Environment (Rule 2)
myenv/
venv/
.venv/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs
dist/
build/
*.egg-info/
.next/
out/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
!backend/.env.example
*.env
*.env.*
env
*.backup

# Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.asc
*.der
secrets/
credentials/
certs/
token.json
serviceAccountKey*.json
client_secret*.json

# Logs
*.log
logs/

# Uploads & Temporary Media
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
temp/
tmp/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.agents/mcp_config.json

# Local SQLite database
*.db
*.sqlite
*.sqlite3

# Directory Junction Aliases
client
server
