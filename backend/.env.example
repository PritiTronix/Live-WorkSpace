# Backend Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Live Workspace Backend API"
DEBUG=True

HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

SECRET_KEY=replace_with_secure_production_secret_key
JWT_SECRET=replace_with_secure_jwt_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/live_workspace
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_workspace

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
