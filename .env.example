# ==============================================================================
# Live Workspace — Environment Configuration Template
# Copy this file to .env and populate with your environment-specific credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Live Workspace SaaS"
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_SECRET=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/live_workspace
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_workspace
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live_workspace

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Live Workspace"

# File Storage Configuration (Local / S3 / GCS)
STORAGE_PROVIDER=local
STORAGE_BUCKET=live-workspace-files
UPLOAD_DIR=./uploads

# Redis & Cache (Optional / Future)
REDIS_URL=redis://localhost:6379/0
