# ==============================================================================
# Live Workspace — Environment Configuration Template
# Copy this file to .env and populate with your environment-specific credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Live Workspace SaaS API"
DEBUG=False

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
SECRET_KEY=your_secret_key_here_32_bytes_hex
JWT_SECRET=your_jwt_secret_here_32_bytes_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL_POOLED=postgresql+asyncpg://<username>:<password>@<host-pooler>/<dbname>?ssl=require
SYNC_DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>/<dbname>?sslmode=require

# Neon S3 Storage
AWS_ENDPOINT_URL_S3=https://<storage-host>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_REGION=ap-southeast-1
S3_BUCKET=uploads
STORAGE_PROVIDER=s3
UPLOAD_DIR=./uploads

# Neon Realtime
NEON_REALTIME_URL=https://<realtime-host>/
NEON_REALTIME_SECRET=<realtime-secret>

# Neon Auth (Optional)
NEON_AUTH_BASE_URL=<your-auth-base-url>

# CORS Settings (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Live Workspace"
